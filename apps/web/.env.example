# Copy to .env and fill in from your own Neon project.
# These are publishable client credentials: they are compiled into the browser
# bundle by design, and every one of them is useless without a user's password.
# The row-level security policies on `maps` are what actually keep maps private.
VITE_STACK_PROJECT_ID=your-stack-project-id
VITE_STACK_PUBLISHABLE_KEY=pck_your-publishable-client-key
VITE_NEON_DATA_API_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/<db>/rest/v1
