{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "paths": { "@field/core": ["../../packages/core/src/index.ts"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/core/src"],
  "exclude": ["node_modules"]
}
