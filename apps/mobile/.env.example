# Copy to .env and fill in from your own Neon project — the same three values
# the web build takes, under different names because Expo reads them in Node
# rather than Vite. `app.config.js` folds them into `expo.extra`.
#
# These are publishable client credentials: they are compiled into the app by
# design, and every one of them is useless without a user's password. The
# row-level security policies on `maps` are what actually keep maps private.
#
# Without them the account switches itself off, the welcome screen never
# appears, and the app is a sheet of paper on one phone.
FIELD_STACK_PROJECT_ID=your-stack-project-id
FIELD_STACK_PUBLISHABLE_KEY=pck_your-publishable-client-key
FIELD_DATA_API_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/<db>/rest/v1
