{
  "name": "field-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace @field/web",
    "build": "npm run build --workspace @field/web",
    "mobile": "npm run start --workspace @field/mobile",
    "ios": "npm run ios --workspace @field/mobile",
    "android": "npm run android --workspace @field/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
